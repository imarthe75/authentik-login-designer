# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://designer_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/authentik_login_designer

# Cache Configuration
# Local Docker: redis://valkey:6379/1
VALKEY_URL=redis://valkey:6379/1

# Security
# Generate with: openssl rand -hex 16
# CRITICAL: Change this immediately in production
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY

# Firma las cookies de sesión de /api/v1/auth/login. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:80,https://auth.casmart.internal

# Public API Base URL
PUBLIC_API_BASE_URL=https://auth.casmart.internal

# Authentik API — misma instancia que authentik-login-manager, requerida
# para el editor de política de contraseña (GET/PATCH PasswordPolicy).
AUTHENTIK_HOST=http://casmarts-core-authentik-server:9000
AUTHENTIK_API_TOKEN=CHANGE_ME_AUTHENTIK_API_TOKEN
