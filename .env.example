# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
# NOTA: en este ecosistema la base real es la MISMA que usa
# authentik-login-manager (authentik_login_manager, no authentik_login_designer)
# — las dos apps comparten tablas (tenants, tenant_themes, tenant_applications,
# tenant_email_bodies, password_policies). No crear una base separada.
DATABASE_URL=postgresql+asyncpg://designer_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/authentik_login_manager

# Cache Configuration
# Local Docker: redis://valkey:6379/1
VALKEY_URL=redis://valkey:6379/1

# Security
# Generate with: openssl rand -hex 16
# CRITICAL: Change this immediately in production
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY

# Firma las cookies de sesión de /api/v1/auth/login. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:80,https://auth.casmart.internal

# Public API Base URL
PUBLIC_API_BASE_URL=https://auth.casmart.internal

# Authentik API — misma instancia que authentik-login-manager, requerida
# para el editor de política de contraseña, favicon→Brand y el receptor
# de webhooks de eventos reales.
AUTHENTIK_HOST=http://casmarts-core-authentik-server:9000
AUTHENTIK_API_TOKEN=CHANGE_ME_AUTHENTIK_API_TOKEN

# Secreto compartido que Authentik debe mandar en X-Webhook-Secret al llamar
# a /api/v1/webhooks/authentik-event. Generate with: openssl rand -hex 32
AUTHENTIK_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# SMTP para correos de prueba y correos reales disparados por eventos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
