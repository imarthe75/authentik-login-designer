# Database PostgreSQL — misma base física que authentik-login-manager
# (authentik_login_manager); ambos comparten las tablas tenants/tenant_themes/
# tenant_applications/tenant_email_bodies/password_policies. No crear una
# base "authentik_login_designer" separada (quedó huérfana, sin tablas, de
# una iteración anterior — ver auditoria 2026-11-03). Usar un rol con DML
# acotado a esa base, nunca el superusuario de Postgres.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_DB_USER:CHANGE_ME_SECURE_PASSWORD@db-primary:5432/authentik_login_manager

# Valkey/Redis Cache
VALKEY_URL=redis://localhost:6379/1

# Admin API Key (must match frontend environment.ts)
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY

# CORS origins (allowed frontend URLs)
CORS_ORIGINS=http://localhost:3000,https://auth.casmart.internal,http://localhost:80

# Public API base URL
PUBLIC_API_BASE_URL=https://auth.casmart.internal
